# ==============================================================================
# DevOps Academy - Global Deployment Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env
#
# IMPORTANT:
# - Do not commit .env to version control.
# - Supply high-entropy credentials for production deployments.
# ==============================================================================

# ─── Application & Runtime ───────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_PORT=80
CLIENT_URL=http://localhost
LOG_LEVEL=info

# ─── PostgreSQL Database ─────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=devops_academy
DB_USER=postgres
DB_PASSWORD=your_strong_database_password_here

# ─── Security & Authentication ───────────────────────────────────────────────
# Minimum 32-character high-entropy string
JWT_SECRET=replace_with_a_secure_minimum_32_character_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── Initial Admin Account Provisioning ──────────────────────────────────────
DEFAULT_ADMIN_USERNAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ReplaceWithStrongAdminPassword123!
ADMIN_EMAIL=admin@example.com

# ─── SMTP Email Notifications (Optional / Console Mode if empty) ─────────────
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DevOps Academy <noreply@devopsacademy.com>"

# ─── Observability & Monitoring (Prometheus & Grafana) ───────────────────────
PROMETHEUS_PORT=9095
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here
