# ==============================================================================
# DevOps Academy Backend Environment Variables
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5200

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devops_academy
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret & Session Duration
JWT_SECRET=devops_academy_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Nodemailer / SMTP Configuration (Gmail SMTP Recommended)
# ------------------------------------------------------------------------------
# To use Gmail:
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to Security -> 2-Step Verification -> App Passwords.
# 3. Create an app named "DevOps Academy" and copy the 16-character password.
# 4. Paste your email in SMTP_USER and the 16-character password in SMTP_PASS.
# Note: If SMTP_USER & SMTP_PASS are empty, the backend runs in MOCK mode (logs to console).
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="DevOps Academy <noreply@devopsacademy.com>"

# ------------------------------------------------------------------------------
# Administrator & Default Account Configuration
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_USERNAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=your_strong_admin_password_here

# Optional: Production API Base URL
VITE_API_URL=https://devopsacademy.onrender.com/api

# ------------------------------------------------------------------------------
# Monitoring & Observability Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=info
PROMETHEUS_PORT=9095
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

