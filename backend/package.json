{
  "name": "devops-academy-backend",
  "version": "1.0.0",
  "description": "Node.js + Express backend API for DevOps Academy with PostgreSQL and JWT Authentication",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node src/config/migrate.js",
    "db:migrate:status": "node src/config/migrate.js --status",
    "db:seed": "node src/config/seed.js",
    "env:validate": "node src/config/validateEnv.js",
    "env:validate:strict": "node src/config/validateEnv.js --strict",
    "security:audit": "npm audit --audit-level=high",
    "test:auth": "node test-auth.js",
    "test:email": "node test-email.js",
    "test:phase2": "node test-phase2.js",
    "test:fixes": "node test-critical-fixes.js",
    "test:missing-apis": "node test-phase2-missing-apis.js",
    "test:monitoring": "node test-monitoring.js",
    "test:deployment": "node test-deployment.js",
    "test:e2e": "node test-phase4-e2e-readiness.js",
    "test:all": "node test-auth.js && node test-email.js && node test-phase2.js && node test-critical-fixes.js && node test-phase2-missing-apis.js && node test-monitoring.js && node test-deployment.js && node test-phase4-e2e-readiness.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.12",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
